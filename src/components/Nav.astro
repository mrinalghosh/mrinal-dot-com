---
/*
 * Temporary text nav. Quiet, bottom-left, stays out of the way.
 * Placeholder until the magnets themselves become the navigation
 * (drag two pieces together -> go somewhere).
 */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'home' },
  { href: '/about', label: 'about' },
  { href: '/work', label: 'work' },
  { href: '/writing', label: 'writing' },
  { href: '/contact', label: 'contact' },
];
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<nav class="site-nav">
  {links.map((l) => (
    <a href={l.href} class:list={['nav-link', { current: isCurrent(l.href) }]}>{l.label}</a>
  ))}
</nav>

<style>
  .site-nav {
    position: fixed;
    left: 1.5rem;
    bottom: 1.25rem;
    z-index: 60;               /* above the magnets, so nav is always reachable */
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .nav-link {
    color: var(--ink-faint);
    border-bottom: none;
    width: max-content;
    transition: color 0.15s ease;
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link.current { color: var(--ink); }
  .nav-link.current::before { content: '· '; color: var(--ink-faint); }

  @media (max-width: 34rem) {
    .site-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.75rem;
      left: 1rem;
      right: 1rem;
      bottom: 0.9rem;
    }
  }
</style>
