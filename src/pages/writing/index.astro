---
import { getCollection } from 'astro:content';
import Canvas from '../../layouts/Canvas.astro';
import { withBase } from '../../lib/url';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Canvas title="writing" description="Notes and posts by Mrinal.">
  <p class="eyebrow">writing</p>
  {posts.length === 0 ? (
    <p class="lede">Nothing here yet.</p>
  ) : (
    <ul class="list">
      {posts.map((post) => (
        <li>
          <a href={withBase(`/writing/${post.id}`)}>
            <span class="title">{post.data.title}</span>
            <span class="meta">{fmt(post.data.pubDate)}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Canvas>
